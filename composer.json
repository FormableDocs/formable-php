{
  "name": "formable/formable",
  "description": "Official PHP SDK for the Formable API",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "formable",
    "esignature",
    "redlining",
    "contracts",
    "sdk"
  ],
  "authors": [
    {
      "name": "Formable"
    }
  ],
  "homepage": "https://www.formabledocs.com",
  "support": {
    "issues": "https://github.com/FormableDocs/formable-php/issues",
    "source": "https://github.com/FormableDocs/formable-php"
  },
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Formable\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Formable\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
